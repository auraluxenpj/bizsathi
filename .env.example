# Browser-visible Supabase settings. These are public values, not secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase settings.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI features. Keep this key server-side; never prefix it with VITE_.
GOOGLE_GENERATIVE_AI_API_KEY=

# Private Google Sheets access. Store the service-account JSON as one-line JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional Auraluxe website stock sync.
WEBSITE_SYNC_URL=https://www.auraluxe.com.np/api/public/inventory-sync
INVENTORY_SYNC_SECRET=

# Scheduled endpoint authentication. Previous secret is optional during rotation.
BIZSATHI_CRON_SECRET=
BIZSATHI_CRON_SECRET_PREVIOUS=

# Local Drizzle migration tooling only; not a Worker runtime variable.
DATABASE_URL=
